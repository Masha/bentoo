+#if DDCUTIL_VERSION >= QT_VERSION_CHECK(2, 1, 0)
+    // A monitor that is still waking up (e.g. right after login) fails ddcutil's initial
+    // DDC check and is only reported among the invalid displays. ddcutil rechecks hotplugged
+    // displays only, so redetect a few times with backoff to pick it up once it answers.
+    DDCA_Display_Ref *allDisplayRefs = nullptr;
+    ddca_get_display_refs(true, &allDisplayRefs);
+    int allDisplayCount = 0;
+    while (allDisplayRefs[allDisplayCount] != nullptr) {
+        ++allDisplayCount;
+    }
+    if (allDisplayCount == displayCount) {
+        m_redetectRetries = 0;
+    } else if (m_redetectRetries < 4) {
+        const int delayMs = 2000 << m_redetectRetries++;
+        qCWarning(POWERDEVIL) << "[DDCutilDetector]:" << allDisplayCount - displayCount
+                              << "display(s) without working DDC/CI - redetecting in" << delayMs << "ms, attempt" << m_redetectRetries;
+        QTimer::singleShot(delayMs, this, &DDCutilPrivateSingleton::redetect);
+    }
+#endif
 }
 
