# bentoo platform baseline: amd64 at x86-64-v3 (hardware from 2017 onward).
# X86_64_VERSION comes from the CachyOS tree; mainline only offers native
# or generic x86-64.
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CachyOS tweaks (readahead, EEVDF tuning, swappiness, ...). Tree default,
# stated here so the required-options check covers it.
CONFIG_CACHY=y
# Desktop latency, as linux-cachyos ships it. Fedora's base is 300 Hz.
CONFIG_HZ_1000=y
# Full preemption by default; PREEMPT_DYNAMIC keeps preempt=voluntary or
# preempt=none available on the kernel command line for servers.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# Wine/Proton NT synchronisation primitives.
CONFIG_NTSYNC=m
