# sched_ext depends on BTF, which gentoo-kernel-config's no-debug.config
# turns off. Bring back BTF only: DWARF from the toolchain default is what
# pahole reads, and the build strips it from the installed modules.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
