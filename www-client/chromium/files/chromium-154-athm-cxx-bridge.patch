diff --git a/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs b/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs
new file mode 100644
index 0000000..22cbf3c
--- /dev/null
+++ b/components/private_verification_tokens/common/athm_ffi/athm_cxx.rs
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `cxx` bridge over the client half of `athm_ffi`, for builds where Crubit's
+//! `cpp_api_from_rust` is unavailable (`enable_cpp_api_from_rust == false`).
+//!
+//! It exposes exactly the operations `PrivacyPassAthmBatchRequest` needs, and
+//! nothing else: the protocol logic stays in `athm_ffi`, this file only adapts
+//! calling conventions. `cxx` cannot return `Result` without C++ exceptions,
+//! which Chromium disables, so a failed constructor yields an object whose
+//! `*_ok()` accessor is false instead.
+
+chromium::import! {
+    "//components/private_verification_tokens/common/athm_ffi:athm_ffi";
+}
+
+use athm_ffi::{AthmClientRequest, AthmParameters};
+
+#[cxx::bridge(namespace = "private_verification_tokens::athm_cxx")]
+mod ffi {
+    extern "Rust" {
+        type AthmCxxParameters;
+        type AthmCxxClientRequest;
+
+        fn new_parameters(n_buckets: u8, deployment_id: &[u8]) -> Box<AthmCxxParameters>;
+        fn parameters_ok(self: &AthmCxxParameters) -> bool;
+        fn token_response_size(self: &AthmCxxParameters) -> usize;
+
+        fn new_client_request(
+            public_key: &[u8],
+            public_key_proof: &[u8],
+            params: &AthmCxxParameters,
+        ) -> Box<AthmCxxClientRequest>;
+        fn client_request_ok(self: &AthmCxxClientRequest) -> bool;
+        fn request(self: &AthmCxxClientRequest) -> Vec<u8>;
+        fn finalize(
+            self: &AthmCxxClientRequest,
+            public_key: &[u8],
+            response: &[u8],
+            params: &AthmCxxParameters,
+            token: &mut Vec<u8>,
+        ) -> bool;
+    }
+}
+
+pub struct AthmCxxParameters(Option<AthmParameters>);
+
+fn new_parameters(n_buckets: u8, deployment_id: &[u8]) -> Box<AthmCxxParameters> {
+    Box::new(AthmCxxParameters(AthmParameters::try_new(n_buckets, deployment_id).ok()))
+}
+
+impl AthmCxxParameters {
+    fn parameters_ok(&self) -> bool {
+        self.0.is_some()
+    }
+
+    fn token_response_size(&self) -> usize {
+        self.0.as_ref().map_or(0, AthmParameters::token_response_size)
+    }
+}
+
+pub struct AthmCxxClientRequest(Option<AthmClientRequest>);
+
+fn new_client_request(
+    public_key: &[u8],
+    public_key_proof: &[u8],
+    params: &AthmCxxParameters,
+) -> Box<AthmCxxClientRequest> {
+    let request = params
+        .0
+        .as_ref()
+        .and_then(|params| AthmClientRequest::try_new(public_key, public_key_proof, params).ok());
+    Box::new(AthmCxxClientRequest(request))
+}
+
+impl AthmCxxClientRequest {
+    fn client_request_ok(&self) -> bool {
+        self.0.is_some()
+    }
+
+    fn request(&self) -> Vec<u8> {
+        self.0.as_ref().map_or_else(Vec::new, AthmClientRequest::request)
+    }
+
+    fn finalize(
+        &self,
+        public_key: &[u8],
+        response: &[u8],
+        params: &AthmCxxParameters,
+        token: &mut Vec<u8>,
+    ) -> bool {
+        let (Some(request), Some(params)) = (self.0.as_ref(), params.0.as_ref()) else {
+            return false;
+        };
+        match request.finalize(public_key, response, params) {
+            Ok(bytes) => {
+                *token = bytes;
+                true
+            }
+            Err(_) => false,
+        }
+    }
+}
