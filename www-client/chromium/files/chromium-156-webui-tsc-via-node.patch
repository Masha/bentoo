From: Lucas C.S. <lucascs@protonmail.com>
Subject: [PATCH] third_party/typescript: run the JS tsc through node, not the prebuilt tsgo ELF

M156 dropped the `use_typescript_go` gn arg and the node branch behind it:
tools/typescript/ts_library.py and ts_definitions.py now always call
//third_party/typescript/typescript.py, which execs the prebuilt tsgo binary
under third_party/typescript/linux-amd64/src/lib/tsc, and tsgo.gni lists that
binary plus ~110 lib.*.d.ts files beside it as ninja inputs.  The ebuild's
`use_typescript_go=false` became a no-op, and the build dies:

  ninja: error: '../../third_party/typescript/typescript.py', needed by
  'gen/third_party/lit/v3_0/tsconfig_build_ts.json', missing and no known
  rule to make it

Point typescript.py at the JS compiler in //third_party/node/node_modules,
run through //third_party/node (the system node the ebuild symlinks in) --
exactly what the M155 node branch ran: TypeScript 6.0.2 in both 155 and 156,
and tools/typescript/tsconfig_base.json is byte-identical between them.
tsgo.gni keeps its name and `tsgo_inputs` (both .gni importers expect them)
but lists the JS compiler instead of the ELF.

The ebuild keeps third_party/typescript in keeplibs so typescript.py survives
unbundling; the ELF under linux-amd64/ is no longer referenced.  Same idea as
chromium-155-devtools-tsc-binary-via-node.patch for devtools-frontend.  Drop
both once the tree ships a tsgo that survives unbundling, or a system tsgo is
packaged.
diff --git a/third_party/typescript/typescript.py b/third_party/typescript/typescript.py
--- a/third_party/typescript/typescript.py
+++ b/third_party/typescript/typescript.py
@@ -9,6 +9,10 @@
 import sys
 import os
 
+sys.path.append(os_path.join(os_path.dirname(__file__), '..', 'node'))
+import node
+import node_modules
+
 
 def GetBinaryPath():
   if platform.machine() == 'arm64':
@@ -24,12 +28,9 @@
 
 
 def RunTypeScriptRaw(cmd_parts, stdout=None):
-  cmd = [GetBinaryPath()] + cmd_parts
-  process = subprocess.Popen(
-      cmd, cwd=os.getcwd(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
-      universal_newlines=True, encoding='utf-8')
-  stdout, stderr = process.communicate()
-  return process.returncode, stdout, stderr
+  # Run the JS compiler from third_party/node/node_modules through node, not
+  # the prebuilt tsgo ELF that GetBinaryPath() names.
+  return node.RunNodeRaw([node_modules.PathToTypescript()] + cmd_parts, stdout)
 
 
 def RunTypeScript(cmd_parts, stdout=None):
@@ -47,7 +48,7 @@
       # example https://github.com/microsoft/TypeScript/issues/615
       errs.append("stdout:\n" + stdout)
     errs.append("exit=%d" % code)
-    cmd = [GetBinaryPath()] + cmd_parts
+    cmd = [node.GetBinaryPath(), node_modules.PathToTypescript()] + cmd_parts
     raise RuntimeError('Command \'%s\' failed\n%s' % (
         ' '.join(cmd), '\n'.join(errs)))
   return stdout
diff --git a/third_party/typescript/tsgo.gni b/third_party/typescript/tsgo.gni
--- a/third_party/typescript/tsgo.gni
+++ b/third_party/typescript/tsgo.gni
@@ -2,141 +2,10 @@
 # Use of this source code is governed by a BSD-style license that can be
 # found in the LICENSE file.
 
-import("//build/toolchain/rbe.gni")
-
-if (host_os == "linux" || use_remoteexec) {
-  _platform_dir = "linux-amd64"
-  _binary_name = "tsc"
-} else if (host_os == "mac") {
-  if (host_cpu == "arm64") {
-    _platform_dir = "mac-arm64"
-  } else {
-    _platform_dir = "mac-amd64"
-  }
-  _binary_name = "tsc"
-} else if (host_os == "win") {
-  _platform_dir = "windows-amd64"
-  _binary_name = "tsc.exe"
-}
-
-assert(defined(_platform_dir), "Did not find binary for host_os='${host_os}'")
-
+# The JS compiler from //third_party/node/node_modules stands in for the
+# prebuilt tsgo binary; see typescript.py.  Its lib.*.d.ts files sit next to it
+# and were never listed as inputs on the node path.
 tsgo_inputs = [
   "//third_party/typescript/typescript.py",
-  "//third_party/typescript/$_platform_dir/src/lib/$_binary_name",
+  "//third_party/node/node_modules/typescript/bin/tsc",
 ]
