# Read by branding.eclass (::gentoo). sys-apps/baselayout writes these into
# /usr/lib/os-release, and every other package inheriting the eclass reports
# them as its packager (GNU --version, gcc's pkgversion, ...).
#
# ID changes from gentoo to bentoo; ID_LIKE keeps anything that tests for a
# Gentoo system working. kernel-install names UKIs by ENTRY_TOKEN, so a host
# whose /etc/kernel/entry-token is set is unaffected; on one that falls back to
# ID, new UKIs land beside the old gentoo-* ones and both stay bootable.
BRANDING_OS_NAME="Bentoo"
BRANDING_OS_ID="bentoo"
BRANDING_OS_ID_LIKE="gentoo"
BRANDING_OS_PRETTY_NAME="Bentoo Linux"
BRANDING_OS_HOME_URL="https://github.com/obentoo/bentoo"
BRANDING_OS_SUPPORT_URL="https://t.me/bentoolinux"
BRANDING_OS_BUG_REPORT_URL="https://github.com/obentoo/bentoo/issues"
