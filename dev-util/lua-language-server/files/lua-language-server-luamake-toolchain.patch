Honour CC/AR/CFLAGS/CXXFLAGS/LDFLAGS in the luamake gcc backend and stop
it from stripping the binary at link time (Portage strips and splits debug
info itself).

--- a/3rd/luamake/scripts/compiler/gcc.lua
+++ b/3rd/luamake/scripts/compiler/gcc.lua
@@ -25,8 +25,10 @@
         ldflags[#ldflags+1] = "-lstdc++"
         ldflags[#ldflags+1] = "-Wl,-Bdynamic"
     end
-    if attribute.mode ~= "debug" then
-        ldflags[#ldflags+1] = "-s"
+    -- bentoo: never strip here, Portage does it (and splits debug info);
+    -- honour LDFLAGS from the environment instead.
+    for flag in (os.getenv "LDFLAGS" or ""):gmatch "%S+" do
+        ldflags[#ldflags+1] = flag
     end
     if attribute.lto ~= "off" then
         ldflags[#ldflags+1] = "-flto"
