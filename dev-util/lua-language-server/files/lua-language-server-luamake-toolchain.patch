+-- bentoo: append the distribution's compiler flags from the environment.
+-- They go last on the command line so that they win over upstream's
+-- defaults (-O2 and friends).
+local function env_flags(name)
+    return os.getenv(name) or ""
+end
+
 local function format_path(path)
     if path:match " " then
         return '"'..path..'"'
