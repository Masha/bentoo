index 0000000..7b1ba5c
--- /dev/null
+++ b/crates/settings_ui/src/pages/agent_jail_account.rs
@@ -0,0 +1,269 @@
+//! The Agent Sandbox page's Claude account block (Zeo next §6.65): which kyomei account this
+//! project's jail logs in with, or its own login as before. A kyomei account is delivered as an
+//! access token alone before each start, so a new project needs no login; "Connect a new
+//! account…" runs `kyomei add` -- a fresh login, never a copy -- in a terminal of the workspace.
+
+use std::path::Path;
+
+use agent_sandbox::AgentSandboxSettings;
+use agent_sandbox::capabilities::set_project_account;
+use agent_sandbox::jail_account::{self, AccountProblem, KyomeiAccount};
+use gpui::{AnyElement, App, Entity, ScrollHandle, WindowHandle};
+use settings::Settings as _;
+use ui::{SwitchField, ToggleState, prelude::*};
+use util::ResultExt as _;
+use workspace::MultiWorkspace;
+use zeo_i18n::t;
+
+use super::agent_jail_capabilities::source_row;
+use super::{JailPageState, reveal};
+
+/// One switch of the block. Exactly one is on: the account the start will use.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct AccountRow {
+    /// What the setting stores when this switch is turned on; `""` is the project's own login.
+    pub reference: String,
+    pub label: String,
+    pub note: String,
+    pub chosen: bool,
+}
+
+/// The block's rows: the project's own login, every kyomei account, then a chosen reference
+/// kyomei does not answer for. `None` is kyomei still being read; `Err` one that could not be.
+pub(crate) fn account_rows(
+    accounts: Option<&Result<Vec<KyomeiAccount>, AccountProblem>>,
+    chosen: Option<&str>,
+) -> Vec<AccountRow> {
+    let mut rows = vec![AccountRow {
+        reference: String::new(),
+        label: t!("agent-sandbox-account-own"),
+        note: t!("agent-sandbox-account-own-note"),
+        chosen: chosen.is_none(),
+    }];
+    let listed: &[KyomeiAccount] = match accounts {
+        Some(Ok(accounts)) => accounts,
+        _ => &[],
+    };
+    for account in listed {
+        let email = account.email.clone().unwrap_or_default();
+        let label = match (&account.alias, &account.email) {
+            (Some(alias), Some(email)) if !alias.is_empty() => format!("{alias} · {email}"),
+            (_, Some(email)) => email.clone(),
+            (Some(alias), None) => alias.clone(),
+            (None, None) => format!("#{}", account.number),
+        };
+        let note = if account.quarantined() {
+            t!("agent-sandbox-account-quarantined", email = email)
+        } else {
+            format!("#{} · {}", account.number, account.auth_status)
+        };
+        rows.push(AccountRow {
+            reference: account.reference(),
+            label,
+            note,
+            chosen: chosen.is_some_and(|chosen| account.answers_to(chosen)),
+        });
+    }
+    // Only an answer from kyomei can say a choice is gone; while it is read, or unreadable, the
+    // choice is shown as it is.
+    if let Some(chosen) = chosen
+        && !rows.iter().any(|row| row.chosen)
+    {
+        let note = if matches!(accounts, Some(Ok(_))) {
+            t!(
+                "agent-sandbox-account-missing",
+                account = chosen.to_string()
+            )
+        } else {
+            String::new()
+        };
+        rows.push(AccountRow {
+            reference: chosen.to_string(),
+            label: chosen.to_string(),
+            note,
+            chosen: true,
+        });
+    }
+    rows
+}
+
+/// The setting a switch writes when toggled: on picks its account (or the own login), and
+/// turning the chosen account off falls back to the own login rather than to nothing.
+pub(crate) fn account_after_toggle(row: &AccountRow, on: bool) -> Option<String> {
+    Some(if on {
+        row.reference.clone()
+    } else {
+        String::new()
+    })
+}
+
+/// The Claude account block of the project section.
+pub(crate) fn render_account(
+    root: &Path,
+    key: Option<&str>,
+    workspace_window: Option<WindowHandle<MultiWorkspace>>,
+    state: &Entity<JailPageState>,
+    scroll_handle: &ScrollHandle,
+    cx: &mut App,
+) -> AnyElement {
+    let sandbox = AgentSandboxSettings::get_global(cx).clone();
+    let chosen = sandbox.account_for_key(key).map(str::to_string);
+    let accounts = state.read(cx).accounts.clone();
+    let rows = account_rows(accounts.as_ref(), chosen.as_deref());
+
+    let mut switches = Vec::with_capacity(rows.len());
+    for row in rows {
+        let id = format!("agent-jail-account-{}", row.reference);
+        let switch = SwitchField::new(
+            SharedString::from(id.clone()),
+            Some(SharedString::from(row.label.clone())),
+            (!row.note.is_empty()).then(|| row.note.clone().into()),
+            row.chosen,
+            {
+                let root = root.to_path_buf();
+                move |toggle, _, cx| {
+                    let on = *toggle == ToggleState::Selected;
+                    set_project_account(&root, account_after_toggle(&row, on), cx).detach();
+                }
+            },
+        )
+        .tab_index(0);
+        switches.push(reveal(state, id, scroll_handle, switch, cx));
+    }
+
+    let muted = |text: String| Label::new(text).size(LabelSize::Small).color(Color::Muted);
+    let source = source_row(
+        "agent-jail-account-reset",
+        t!("agent-sandbox-account-reset"),
+        sandbox.account_set_for_key(key),
+        {
+            let root = root.to_path_buf();
+            move |cx: &mut App| set_project_account(&root, None, cx).detach()
+        },
+        state,
+        scroll_handle,
+        cx,
+    );
+    let status = match &accounts {
+        Some(Err(problem)) => Some(t!(
+            "agent-sandbox-account-unavailable",
+            reason = problem.as_str()
+        )),
+        Some(Ok(listed)) if listed.is_empty() => Some(t!("agent-sandbox-account-none")),
+        _ => None,
+    };
+
+    let connect = Button::new(
+        "agent-jail-account-connect",
+        t!("agent-sandbox-account-connect"),
+    )
+    .style(ButtonStyle::Outlined)
+    .size(ButtonSize::Medium)
+    .tab_index(0_isize)
+    .disabled(workspace_window.is_none())
+    .on_click({
+        let state = state.clone();
+        let kyomei = sandbox.kyomei_path;
+        move |_, _, cx| connect_account(kyomei.as_deref(), workspace_window, &state, cx)
+    });
+    let refresh = Button::new(
+        "agent-jail-account-refresh",
+        t!("agent-sandbox-account-refresh"),
+    )
+    .style(ButtonStyle::Subtle)
+    .size(ButtonSize::Medium)
+    .tab_index(0_isize)
+    .on_click({
+        let state = state.clone();
+        move |_, _, cx| state.update(cx, |state, cx| state.reload_accounts(cx))
+    });
+
+    // Wrapped like the page's other buttons: without it Tab skips them (Xvfb proof, 2026-11-28).
+    let connect = reveal(
+        state,
+        "agent-jail-account-connect",
+        scroll_handle,
+        connect,
+        cx,
+    );
+    let refresh = reveal(
+        state,
+        "agent-jail-account-refresh",
+        scroll_handle,
+        refresh,
+        cx,
+    );
+    v_flex()
+        .gap_2()
+        .debug_selector(|| "agent-jail-account".into())
+        .child(
+            v_flex()
+                .gap_0p5()
+                .child(Label::new(t!("agent-sandbox-account")).size(LabelSize::Small))
+                .child(muted(t!("agent-sandbox-account-note")))
+                .child(source),
+        )
+        .children(status.map(muted))
+        .children(switches)
+        .child(
+            v_flex()
+                .gap_0p5()
+                .child(h_flex().gap_2().child(connect).child(refresh))
+                .child(muted(t!("agent-sandbox-account-connect-note"))),
+        )
+        .into_any_element()
+}
+
+/// Runs `kyomei add` in a new terminal of the workspace the settings were opened from, then
+/// reads the accounts again so the new one is listed. The login itself -- a browser round trip
+/// and, at times, a pasted code -- needs a terminal, which the settings window has not.
+fn connect_account(
+    configured: Option<&Path>,
+    workspace_window: Option<WindowHandle<MultiWorkspace>>,
+    state: &Entity<JailPageState>,
+    cx: &mut App,
+) {
+    let Some(workspace_window) = workspace_window else {
+        return;
+    };
+    let program = jail_account::locate(configured)
+        .map(|path| path.to_string_lossy().into_owned())
+        .unwrap_or_else(|| "kyomei".to_string());
+    let spawn = task::SpawnInTerminal {
+        id: task::TaskId("zeo-kyomei-add".into()),
+        label: "kyomei add".into(),
+        full_label: "kyomei add".into(),
+        command_label: "kyomei add".into(),
+        use_new_terminal: true,
+        allow_concurrent_runs: false,
+        reveal: task::RevealStrategy::Always,
+        shell: task::Shell::WithArguments {
+            program,
+            args: vec!["add".into()],
+            title_override: None,
+        },
+        ..Default::default()
+    };
+    let run = workspace_window
+        .update(cx, |multi_workspace, window, cx| {
+            multi_workspace.workspace().update(cx, |workspace, cx| {
+                workspace.spawn_in_terminal(spawn, window, cx)
+            })
+        })
+        .log_err();
+    let Some(run) = run else {
+        return;
+    };
+    let state = state.downgrade();
+    cx.spawn(async move |cx| {
+        run.await;
+        state
+            .update(cx, |state, cx| state.reload_accounts(cx))
+            .log_err();
+    })
+    .detach();
+}
+
+#[cfg(test)]
+#[path = "agent_jail_account_tests.rs"]
+mod agent_jail_account_tests;
diff --git a/crates/settings_ui/src/pages/agent_jail_account_tests.rs b/crates/settings_ui/src/pages/agent_jail_account_tests.rs
new file mode 100644
index 0000000..a817288
--- /dev/null
+++ b/crates/settings_ui/src/pages/agent_jail_account_tests.rs
@@ -0,0 +1,84 @@
+//! The Claude account block's rows (§6.65): the own login, kyomei's accounts, and a chosen
+//! reference kyomei no longer answers for -- and which one switch is on.
+
+use agent_sandbox::jail_account::{AccountProblem, KyomeiAccount};
+
+use super::{AccountRow, account_after_toggle, account_rows};
+
+fn account(number: u32, alias: Option<&str>, email: &str, status: &str) -> KyomeiAccount {
+    KyomeiAccount {
+        number,
+        alias: alias.map(str::to_string),
+        email: Some(email.to_string()),
+        auth_status: status.to_string(),
+    }
+}
+
+fn listed() -> Result<Vec<KyomeiAccount>, AccountProblem> {
+    Ok(vec![
+        account(1, Some("work"), "w@example.invalid", "valid"),
+        account(2, None, "h@example.invalid", "invalid_grant"),
+    ])
+}
+
+fn chosen(rows: &[AccountRow]) -> Vec<&str> {
+    rows.iter()
+        .filter(|row| row.chosen)
+        .map(|row| row.reference.as_str())
+        .collect()
+}
+
+#[test]
+fn without_a_choice_the_own_login_is_on() {
+    let rows = account_rows(Some(&listed()), None);
+    let references: Vec<&str> = rows.iter().map(|row| row.reference.as_str()).collect();
+    assert_eq!(references, ["", "work", "2"]);
+    assert_eq!(chosen(&rows), [""]);
+}
+
+#[test]
+fn a_choice_by_number_alias_or_email_turns_on_its_account_alone() {
+    for reference in ["1", "work", "w@example.invalid"] {
+        let rows = account_rows(Some(&listed()), Some(reference));
+        assert_eq!(chosen(&rows), ["work"], "{reference}");
+        assert_eq!(rows.len(), 3, "no extra row for a choice kyomei answers");
+    }
+}
+
+#[test]
+fn a_quarantined_account_says_to_connect_it_again() {
+    let rows = account_rows(Some(&listed()), None);
+    assert!(
+        rows[2].note.contains("h@example.invalid"),
+        "{}",
+        rows[2].note
+    );
+    assert!(rows[1].label.contains("work") && rows[1].label.contains("w@example.invalid"));
+}
+
+#[test]
+fn a_choice_kyomei_no_longer_holds_stays_listed_and_on() {
+    let rows = account_rows(Some(&listed()), Some("gone"));
+    assert_eq!(chosen(&rows), ["gone"]);
+    assert!(rows.last().is_some_and(|row| row.note.contains("gone")));
+}
+
+#[test]
+fn while_kyomei_is_read_or_unreadable_the_choice_is_shown_as_it_is() {
+    for accounts in [None, Some(Err(AccountProblem::NotInstalled))] {
+        let rows = account_rows(accounts.as_ref(), Some("work"));
+        assert_eq!(chosen(&rows), ["work"]);
+        assert!(
+            rows.last().is_some_and(|row| row.note.is_empty()),
+            "no 'missing' guess"
+        );
+    }
+}
+
+#[test]
+fn turning_an_account_off_falls_back_to_the_own_login() {
+    let rows = account_rows(Some(&listed()), Some("work"));
+    assert_eq!(account_after_toggle(&rows[1], false), Some(String::new()));
+    assert_eq!(account_after_toggle(&rows[2], true), Some("2".to_string()));
+    assert_eq!(account_after_toggle(&rows[0], true), Some(String::new()));
+}
