diff --git a/crates/agent_sandbox/src/jail_account.rs b/crates/agent_sandbox/src/jail_account.rs
new file mode 100644
index 0000000..c77561f
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_account.rs
@@ -0,0 +1,245 @@
+//! A Claude account for a jail, from kyomei (Zeo next §6.65, §6.70).
+//!
+//! Without it each jailed project has its own `CLAUDE_CONFIG_DIR` and logs in by itself. A copy of
+//! one login cannot be shared instead: Anthropic's refresh token is single-use, so two copies kill
+//! each other. kyomei keeps every refresh token in its vault and writes into a project's config
+//! dir a *badge* -- the access token alone -- before each start, and rewrites it before it expires
+//! (`kyomei redeliver`). The jail can use the account and cannot renew, leak or destroy it.
+//!
+//! Zeo never reads a token: it runs `kyomei deliver` and reads back only the account number, its
+//! e-mail and the expiry, and `kyomei list` for the picker.
+
+use std::io;
+use std::path::{Path, PathBuf};
+use std::pin::pin;
+use std::process::Stdio;
+use std::time::Duration;
+
+use futures::{AsyncReadExt as _, FutureExt as _};
+use gpui::BackgroundExecutor;
+use serde::Deserialize;
+
+/// A delivery may renew the account first, which is one HTTPS round trip to Anthropic; kyomei
+/// bounds that at 30 s, and its lock waits at 9 s each.
+const DELIVER_TIMEOUT: Duration = Duration::from_secs(60);
+const LIST_TIMEOUT: Duration = Duration::from_secs(10);
+/// kyomei's JSON is a few hundred bytes per account.
+const MAX_OUTPUT_BYTES: u64 = 256 * 1024;
+
+/// kyomei's exit codes (its docs/overview/06-interfaces.md §1.1).
+const EXIT_NOTHING: i32 = 2;
+const EXIT_BLOCKED: i32 = 3;
+
+/// The one `--json` contract version this Zeo reads.
+const SCHEMA_VERSION: u32 = 1;
+
+/// Why an account could not be handed to a jail. Each names a cause and never a value: kyomei's
+/// own diagnostics stay in its stderr, which is not read.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AccountProblem {
+    /// No kyomei at the configured path or on `PATH`.
+    NotInstalled,
+    /// kyomei could not be started.
+    Spawn(String),
+    TimedOut,
+    /// Exit 3: a credential lock held past the wait, or the account quarantined -- its refresh
+    /// token was refused and someone must log in to it again (`kyomei add`).
+    Blocked,
+    /// Any other failure; the exit code, when there is one.
+    Failed(Option<i32>),
+    /// An answer this Zeo does not read: another schema version, or not JSON.
+    Unreadable,
+}
+
+impl AccountProblem {
+    /// The `reason=` token of the refusal's log line and the message's argument.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::NotInstalled => "not-installed",
+            Self::Spawn(_) => "spawn",
+            Self::TimedOut => "timed-out",
+            Self::Blocked => "blocked",
+            Self::Failed(_) => "failed",
+            Self::Unreadable => "unreadable",
+        }
+    }
+}
+
+/// One account kyomei holds, as the picker shows it.
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct KyomeiAccount {
+    pub number: u32,
+    #[serde(default)]
+    pub alias: Option<String>,
+    #[serde(default)]
+    pub email: Option<String>,
+    /// valid · expiring · expired · invalid_grant. An expired slot is normal: the next delivery
+    /// renews it. invalid_grant cannot be delivered until someone logs in again.
+    pub auth_status: String,
+}
+
+impl KyomeiAccount {
+    /// The reference the setting stores: the alias when there is one, since it survives the
+    /// account being logged in again, else the slot number.
+    pub fn reference(&self) -> String {
+        match self.alias.as_deref().filter(|alias| !alias.is_empty()) {
+            Some(alias) => alias.to_string(),
+            None => self.number.to_string(),
+        }
+    }
+
+    /// Whether `reference`, as stored in a setting, names this account.
+    pub fn answers_to(&self, reference: &str) -> bool {
+        reference == self.number.to_string()
+            || self.alias.as_deref() == Some(reference)
+            || self.email.as_deref() == Some(reference)
+    }
+
+    pub fn quarantined(&self) -> bool {
+        self.auth_status == "invalid_grant"
+    }
+}
+
+/// What a delivery wrote, minus the token.
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct Delivered {
+    pub account: u32,
+    #[serde(default)]
+    pub email: Option<String>,
+    pub expires_at: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ListAnswer {
+    schema_version: u32,
+    accounts: Vec<KyomeiAccount>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct DeliverAnswer {
+    schema_version: u32,
+    delivered: Delivered,
+}
+
+/// Where kyomei is: the setting, `~` expanded, else `PATH`.
+pub fn locate(setting: Option<&Path>) -> Option<PathBuf> {
+    match setting {
+        Some(path) => Some(match path.strip_prefix("~") {
+            Ok(rest) => paths::home_dir().join(rest),
+            Err(_) => path.to_path_buf(),
+        }),
+        None => which::which("kyomei").ok(),
+    }
+}
+
+/// Writes `account`'s badge into `claude_dir`: `kyomei deliver <account> --config-dir <dir>`.
+pub async fn deliver(
+    kyomei: &Path,
+    account: &str,
+    claude_dir: &Path,
+    executor: &BackgroundExecutor,
+) -> Result<Delivered, AccountProblem> {
+    let dir = claude_dir.as_os_str().to_owned();
+    let args = [
+        "deliver".into(),
+        account.into(),
+        "--config-dir".into(),
+        dir,
+        "--json".into(),
+    ];
+    let stdout = run(kyomei, &args, DELIVER_TIMEOUT, executor).await?;
+    parse_deliver(&stdout)
+}
+
+/// The accounts kyomei holds: `kyomei list --json`.
+pub async fn list(
+    kyomei: &Path,
+    executor: &BackgroundExecutor,
+) -> Result<Vec<KyomeiAccount>, AccountProblem> {
+    let args = ["list".into(), "--json".into()];
+    let stdout = run(kyomei, &args, LIST_TIMEOUT, executor).await?;
+    parse_list(&stdout)
+}
+
+pub(crate) fn parse_list(stdout: &[u8]) -> Result<Vec<KyomeiAccount>, AccountProblem> {
+    let answer: ListAnswer =
+        serde_json::from_slice(stdout).map_err(|_| AccountProblem::Unreadable)?;
+    if answer.schema_version != SCHEMA_VERSION {
+        return Err(AccountProblem::Unreadable);
+    }
+    Ok(answer.accounts)
+}
+
+pub(crate) fn parse_deliver(stdout: &[u8]) -> Result<Delivered, AccountProblem> {
+    let answer: DeliverAnswer =
+        serde_json::from_slice(stdout).map_err(|_| AccountProblem::Unreadable)?;
+    if answer.schema_version != SCHEMA_VERSION {
+        return Err(AccountProblem::Unreadable);
+    }
+    Ok(answer.delivered)
+}
+
+/// Maps kyomei's exit status to a problem; `None` is success.
+pub(crate) fn exit_problem(success: bool, code: Option<i32>) -> Option<AccountProblem> {
+    match (success, code) {
+        (true, _) => None,
+        (false, Some(EXIT_BLOCKED)) => Some(AccountProblem::Blocked),
+        // `list` answers 2 only without --json; a deliver never does. Either way it delivered
+        // nothing, so it is a failure here.
+        (false, Some(EXIT_NOTHING)) => Some(AccountProblem::Failed(Some(EXIT_NOTHING))),
+        (false, code) => Some(AccountProblem::Failed(code)),
+    }
+}
+
+async fn run(
+    program: &Path,
+    args: &[std::ffi::OsString],
+    timeout: Duration,
+    executor: &BackgroundExecutor,
+) -> Result<Vec<u8>, AccountProblem> {
+    if !program.is_file() {
+        return Err(AccountProblem::NotInstalled);
+    }
+    let mut work = pin!(run_untimed(program, args).fuse());
+    let mut timer = pin!(executor.timer(timeout).fuse());
+    futures::select_biased! {
+        output = work => output,
+        () = timer => Err(AccountProblem::TimedOut),
+    }
+}
+
+async fn run_untimed(
+    program: &Path,
+    args: &[std::ffi::OsString],
+) -> Result<Vec<u8>, AccountProblem> {
+    // kyomei inherits Zeo's environment: it reads its vault from the XDG directories, may sit
+    // behind an HTTPS proxy, and runs no agent, so nothing in that environment reaches a jail.
+    // Its stderr -- events and diagnostics -- is dropped: Zeo logs the exit, not kyomei's words.
+    let mut child = smol::process::Command::new(program)
+        .args(args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|error: io::Error| AccountProblem::Spawn(error.kind().to_string()))?;
+    let mut stdout = Vec::new();
+    if let Some(pipe) = child.stdout.take() {
+        pipe.take(MAX_OUTPUT_BYTES)
+            .read_to_end(&mut stdout)
+            .await
+            .map_err(|error| AccountProblem::Spawn(error.kind().to_string()))?;
+    }
+    let status = child
+        .status()
+        .await
+        .map_err(|error| AccountProblem::Spawn(error.kind().to_string()))?;
+    match exit_problem(status.success(), status.code()) {
+        None => Ok(stdout),
+        Some(problem) => Err(problem),
+    }
+}
diff --git a/crates/agent_sandbox/src/jail_account_tests.rs b/crates/agent_sandbox/src/jail_account_tests.rs
new file mode 100644
index 0000000..45f63c3
--- /dev/null
+++ b/crates/agent_sandbox/src/jail_account_tests.rs
@@ -0,0 +1,211 @@
+//! Zeo next §6.65: the kyomei account a jail logs in with -- which account a project gets, what
+//! Zeo reads back from kyomei, and the delivery run against a fake kyomei.
+
+use std::os::unix::fs::PermissionsExt as _;
+use std::path::{Path, PathBuf};
+
+use gpui::{TestAppContext, UpdateGlobal as _};
+use serde_json::json;
+use settings::{Settings as _, SettingsStore};
+
+use crate::AgentSandboxSettings;
+use crate::jail_account::{
+    AccountProblem, KyomeiAccount, deliver, exit_problem, list, parse_deliver, parse_list,
+};
+
+fn init(cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        let store = SettingsStore::test(cx);
+        cx.set_global(store);
+        release_channel::init(semver::Version::new(0, 0, 0), cx);
+        crate::init(cx);
+    });
+}
+
+fn set_user_settings(json: serde_json::Value, cx: &mut TestAppContext) {
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store
+                .set_user_settings(&json.to_string(), cx)
+                .result()
+                .expect("user settings parse");
+        })
+    });
+    cx.run_until_parked();
+}
+
+fn account_for(key: Option<&str>, cx: &mut TestAppContext) -> Option<String> {
+    cx.update(|cx| {
+        AgentSandboxSettings::get_global(cx)
+            .account_for_key(key)
+            .map(str::to_string)
+    })
+}
+
+#[gpui::test]
+fn no_account_by_default_so_each_project_logs_in_by_itself(cx: &mut TestAppContext) {
+    init(cx);
+    assert_eq!(account_for(None, cx), None);
+    assert_eq!(account_for(Some("/w/app"), cx), None);
+}
+
+#[gpui::test]
+fn a_project_follows_the_default_chooses_its_own_or_opts_out(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(
+        json!({ "agent_sandbox": {
+            "account": " work ",
+            "projects": {
+                "/w/follows": { "enabled": true },
+                "/w/other": { "account": "2" },
+                "/w/own": { "account": "" },
+            },
+        }}),
+        cx,
+    );
+    assert_eq!(account_for(Some("/w/follows"), cx).as_deref(), Some("work"));
+    assert_eq!(account_for(Some("/w/other"), cx).as_deref(), Some("2"));
+    assert_eq!(
+        account_for(Some("/w/own"), cx),
+        None,
+        "an empty project account is its own login, not the default"
+    );
+    assert!(cx.update(|cx| {
+        let sandbox = AgentSandboxSettings::get_global(cx);
+        sandbox.account_set_for_key(Some("/w/own"))
+            && !sandbox.account_set_for_key(Some("/w/follows"))
+    }));
+}
+
+#[gpui::test]
+fn an_empty_default_is_no_default(cx: &mut TestAppContext) {
+    init(cx);
+    set_user_settings(json!({ "agent_sandbox": { "account": "   " } }), cx);
+    assert_eq!(account_for(Some("/w/app"), cx), None);
+}
+
+#[test]
+fn the_list_is_read_by_its_schema_version() {
+    let accounts = parse_list(
+        br#"{"schemaVersion":1,"activeAccountNumber":null,"accounts":[
+            {"number":1,"alias":"work","email":"w@example.invalid","authStatus":"valid","poolStatus":"eligible","deliveries":[]},
+            {"number":2,"email":"h@example.invalid","authStatus":"invalid_grant","poolStatus":"quarantined","deliveries":["/x"]}
+        ]}"#,
+    )
+    .expect("list");
+    assert_eq!(accounts.len(), 2);
+    assert_eq!(
+        accounts[0].reference(),
+        "work",
+        "the alias survives a re-login"
+    );
+    assert_eq!(accounts[1].reference(), "2");
+    assert!(accounts[1].quarantined() && !accounts[0].quarantined());
+    for reference in ["1", "work", "w@example.invalid"] {
+        assert!(accounts[0].answers_to(reference), "{reference}");
+    }
+    assert!(!accounts[0].answers_to("2"));
+
+    assert_eq!(
+        parse_list(br#"{"schemaVersion":2,"accounts":[]}"#),
+        Err(AccountProblem::Unreadable),
+        "a newer contract is not guessed at"
+    );
+    assert_eq!(parse_list(b"1\twork"), Err(AccountProblem::Unreadable));
+}
+
+#[test]
+fn a_delivery_answer_carries_no_token() {
+    let delivered = parse_deliver(
+        br#"{"schemaVersion":1,"delivered":{"account":3,"email":"w@example.invalid","configDir":"/s/claude","expiresAt":"2026-11-28T20:00:00Z"}}"#,
+    )
+    .expect("deliver");
+    assert_eq!(delivered.account, 3);
+    assert_eq!(delivered.expires_at, "2026-11-28T20:00:00Z");
+}
+
+#[test]
+fn exit_three_is_blocked_and_every_other_failure_is_a_failure() {
+    assert_eq!(exit_problem(true, Some(0)), None);
+    assert_eq!(exit_problem(false, Some(3)), Some(AccountProblem::Blocked));
+    assert_eq!(
+        exit_problem(false, Some(2)),
+        Some(AccountProblem::Failed(Some(2)))
+    );
+    assert_eq!(
+        exit_problem(false, None),
+        Some(AccountProblem::Failed(None))
+    );
+}
+
+/// A kyomei that records its arguments and answers as told.
+fn fake_kyomei(dir: &Path, exit: i32, answer: &str) -> PathBuf {
+    let path = dir.join("kyomei");
+    let log = dir.join("args");
+    let body = format!(
+        "#!/bin/sh\nprintf '%s\\n' \"$@\" > '{}'\nprintf '%s' '{answer}'\necho 'kyomei: diagnostics on stderr' >&2\nexit {exit}\n",
+        log.display()
+    );
+    std::fs::write(&path, body).expect("write");
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).expect("chmod");
+    path
+}
+
+#[gpui::test]
+async fn deliver_runs_kyomei_for_the_projects_claude_dir(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let kyomei = fake_kyomei(
+        tmp.path(),
+        0,
+        r#"{"schemaVersion":1,"delivered":{"account":1,"configDir":"/s/claude","expiresAt":"t"}}"#,
+    );
+    let claude_dir = tmp.path().join("state").join("claude");
+    let delivered = deliver(&kyomei, "work", &claude_dir, &cx.executor())
+        .await
+        .expect("deliver");
+    assert_eq!(delivered.account, 1);
+    let args = std::fs::read_to_string(tmp.path().join("args")).expect("args");
+    assert_eq!(
+        args.lines().collect::<Vec<_>>(),
+        [
+            "deliver",
+            "work",
+            "--config-dir",
+            claude_dir.to_str().expect("utf-8"),
+            "--json"
+        ]
+    );
+}
+
+#[gpui::test]
+async fn a_blocked_or_missing_kyomei_is_a_problem_not_a_start(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let blocked = fake_kyomei(tmp.path(), 3, "");
+    assert_eq!(
+        deliver(&blocked, "work", tmp.path(), &cx.executor()).await,
+        Err(AccountProblem::Blocked)
+    );
+    assert_eq!(
+        list(&tmp.path().join("absent"), &cx.executor()).await,
+        Err(AccountProblem::NotInstalled)
+    );
+}
+
+#[gpui::test]
+async fn list_reads_the_accounts(cx: &mut TestAppContext) {
+    cx.executor().allow_parking();
+    let tmp = tempfile::tempdir().expect("tempdir");
+    let kyomei = fake_kyomei(
+        tmp.path(),
+        0,
+        r#"{"schemaVersion":1,"activeAccountNumber":null,"accounts":[{"number":1,"authStatus":"expired","poolStatus":"eligible","deliveries":[]}]}"#,
+    );
+    let accounts: Vec<KyomeiAccount> = list(&kyomei, &cx.executor()).await.expect("list");
+    assert_eq!(accounts.len(), 1);
+    assert_eq!(
+        std::fs::read_to_string(tmp.path().join("args")).expect("args"),
+        "list\n--json\n"
+    );
+}
