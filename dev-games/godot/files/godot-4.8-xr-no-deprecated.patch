+		Projection cm;
+		cm.set_for_hmd(v + 1, aspect_ratio, intraocular_dist, display_width, display_to_lens, oversample, 0.1, 1000.0);
 		Vector3 center = cm.xform(Vector3(0.0, 0.0, 999.0));
 
 		eye_foci.push_back(Vector2(center.x, center.y));
